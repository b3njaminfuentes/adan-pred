# ─────────────────────────────────────────────────────────────────────────────
# ADAN-PRED — Environment template
# Copy this file to `.env` and fill in your own values:   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── REQUIRED: LLM brain ──────────────────────────────────────────────────────
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── BRIER PROTOCOL (shadow-training scoreboard) ──────────────────────────────
# 1. Go to https://brier.world and connect your wallet (creates your profile)
# 2. Create a bot in your dashboard → it gives you a slug + an ingest key
# 3. Paste them here. Leave blank to run the bot WITHOUT reporting to Brier.
BRIER_URL=https://brier.world
BRIER_BOT_SLUG=
BRIER_INGEST_KEY=

# ── OPTIONAL: extra data feeds (bot runs fine without these) ─────────────────
# Polygon.io — equities/forex backup feed
POLYGON_API_KEY=
# FRED — macro indicators
FRED_API_KEY=

# ── OPTIONAL: runtime tuning ─────────────────────────────────────────────────
# ADAN_DIR=~/.adan-pred      # where state files (pnl.json, etc) live
# ADAN_MODE=paper            # paper trading is the only mode (no real funds)
# ADAN_SNIPER=               # advanced: force sniper LLM model
